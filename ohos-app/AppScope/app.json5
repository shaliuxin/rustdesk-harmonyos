{
  "app": {
    // 包名里不能出现 ohos —— 它是华为保留字，AGC 建应用时直接拒（
    // "应用包名中包含敏感词或者保留字符"）。上架后包名永久不可改。
    "bundleName": "cn.shaliuxin.harmonyremote",
    "vendor": "shaliuxin",
    "versionCode": 104,
    "versionName": "0.1.4",
    "icon": "$media:app_icon",
    "label": "$string:app_name",
    "minAPIVersion": 12,
    "targetAPIVersion": 26
  }
}
