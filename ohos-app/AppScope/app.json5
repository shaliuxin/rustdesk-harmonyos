{
  "app": {
    // 包名里不能出现 ohos —— 它是华为保留字，AGC 建应用时直接拒（
    // "应用包名中包含敏感词或者保留字符"）。上架后包名永久不可改。
    // 现状态：**不上架应用市场，仅用调试/测试证书签名侧载真机**。
    // 程序显示名已改回 "RustDesk"，包名保留 cn.shaliuxin.remotedesk
    // （包名与显示名不一致不再有影响；若今后重新上架，需改为 cn.shaliuxin.rustdesk
    //  并在 AGC 新建应用 + 按新包名重建调试/发布 Profile）。
    // 曾用 cn.shaliuxin.harmonyremote（含 harmony 保留词）。
    "bundleName": "cn.shaliuxin.remotedesk",
    "vendor": "shaliuxin",
    "versionCode": 105,
    "versionName": "0.1.5",
    "icon": "$media:app_icon",
    "label": "$string:app_name",
    "minAPIVersion": 12,
    "targetAPIVersion": 26
  }
}
