{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    // 三种形态共用一套代码：手机/平板做主控（触屏手势），2in1 额外能做被控（键鼠注入）。
    "deviceTypes": ["phone", "tablet", "2in1"],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:app_icon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": ["entity.system.home"],
            "actions": ["action.system.home"]
          }
        ]
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET",
        "reason": "$string:reason_internet",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "always"
        }
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO",
        "reason": "$string:reason_network_info",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "always"
        }
      },
      // 剪贴板同步（本机 → 远端）：读剪贴板必须申请 READ_PASTEBOARD。
      // 它是 system_basic 级 user_grant 权限，除声明外还需要：
      //   1. 在 AGC「ACL 权限」页申请并获取该受限权限（说明远程桌面场景）；
      //   2. 创建调试 Profile 时勾选「受限ACL权限(HarmonyOS API9及以上)」；
      //   3. 用带 ACL 的 Profile 签名，否则安装即报 9568289。
      // 没有 ACL Profile 的环境里 SessionPage 会降级成 PasteButton 安全控件
      // （点击临时免权读取，无需任何签名配置），功能可用只是要手动点一下。
      // 剪贴板本机→远端：当前用 PasteButton 安全控件（点击临时免权读取），
// 不声明 READ_PASTEBOARD。该权限是 system_basic 级，声明了就必须在
// 签名 profile 的 acls.allowed-acls 里有对应 ACL，否则安装被拒(9568289)、
// AGC 上传也会因 profile 权限不一致被拒。等 ACL 申请获批后，重建 Profile
// （勾「受限ACL权限」）并取消下面注释重新编译，即可升级为全自动双向同步
// （SessionPage 里的 requestPastePermission / onPasteboardUpdate 路径已就位）。
// // 剪贴板本机→远端：当前用 PasteButton 安全控件（点击临时免权读取），
// 不声明 READ_PASTEBOARD。该权限是 system_basic 级，声明了就必须在
// 签名 profile 的 acls.allowed-acls 里有对应 ACL，否则安装被拒(9568289)、
// AGC 上传也会因 profile 权限不一致被拒。等 ACL 申请获批后，重建 Profile
// （勾「受限ACL权限」）并取消下面注释重新编译，即可升级为全自动双向同步
// （SessionPage 里的 requestPastePermission / onPasteboardUpdate 路径已就位）。
// {
// //         "name": "ohos.permission.READ_PASTEBOARD",
// //         "reason": "$string:reason_pasteboard",
// //         "usedScene": {
// //           "abilities": ["EntryAbility"],
// //           "when": "inuse"
// //         }
// //       }
    ]
  }
}
