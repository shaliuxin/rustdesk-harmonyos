// 华为调试签名（由 DevEco CLI `devecocli signature generate --type debug` 生成）。
//
// 为什么用华为签名而不是 OpenHarmony 自签：自签证书只有模拟器认，装到华为
// 商用真机会在 `hdc install` 阶段报 `code:9568257 fail to verify pkcs7`。
//
// 注意下面几条都是**本机**绑定的：
//   - certpath/profile/storeFile 是绝对路径，指向 ~/.ohos/config/
//   - storePassword/keyPassword 是 DevEco 的加密格式（十六进制串），明文由
//     ~/.ohos/config/material/ 里的密钥解开，hvigor 不接受明文
// 换机器或换用户目录时必须重新执行一次 `devecocli signature generate`，
// 它会重写本文件的 material 段。
//
// compatibleSdkVersion 与本机 SDK 对齐。如果你装的不是 API 26，只改这一行
// （例如 '5.0.5(17)'），其余不用动。
{
  app: {
    signingConfigs: [
      {
        "name": "default",
        "type": "HarmonyOS",
        "material": {
          "certpath": "C:\\Users\\mingh\\.ohos\\config\\default_ohos-app_5r4oPR_nulwB9AdPEUw3xx1YPUtczNaz7kSD333llOA=.cer",
          "keyAlias": "debugKey",
          "keyPassword": "0000001B8453EFA6A0341056BC5D3C394B6267F261E58085CEE0A6A990F39138408389E8A47BB059C91E03",
          "profile": "C:\\Users\\mingh\\.ohos\\config\\default_ohos-app_5r4oPR_nulwB9AdPEUw3xx1YPUtczNaz7kSD333llOA=.p7b",
          "signAlg": "SHA256withECDSA",
          "storeFile": "C:\\Users\\mingh\\.ohos\\config\\default_ohos-app_5r4oPR_nulwB9AdPEUw3xx1YPUtczNaz7kSD333llOA=.p12",
          "storePassword": "0000001BB754D016186F40D3F8CA309B6C0DF389658A314B4459C67B48D9C0DCBAE8464E29DA68B7F3CEF9"
        }
      }
    ],
    products: [
      {
        name: 'default',
        signingConfig: 'default',
        compatibleSdkVersion: '26.0.0',
        runtimeOS: 'HarmonyOS',
        buildOption: {
          strictMode: {
            caseSensitiveCheck: true,
            useNormalizedOHMUrl: true,
          },
        },
        targetSdkVersion: '26.0.0',
      },
    ],
    buildModeSet: [
      {
        name: 'debug',
      },
      {
        name: 'release',
      },
    ],
  },
  modules: [
    {
      name: 'entry',
      srcPath: './entry',
      targets: [
        {
          name: 'default',
          applyToProducts: [
            'default',
          ],
        },
      ],
    },
  ],
}